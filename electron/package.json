{
  "name": "lumio-desktop",
  "version": "1.0.0",
  "description": "Lumio Desktop \u2014 native desktop client",
  "main": "dist/main.js",
  "productName": "Lumio",
  "scripts": {
    "dev": "node init && tsc && electron .",
    "dev:watch": "node init && concurrently \"tsc -w\" \"nodemon --watch dist --exec electron .\"",
    "build:ts": "node init && tsc",
    "build": "node init && tsc && electron-builder",
    "build:mac": "node init && tsc && electron-builder --mac",
    "build:win": "node init && tsc && electron-builder --win",
    "build:linux": "node init && tsc && electron-builder --linux",
    "pack": "tsc && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9",
    "typescript": "^5.8.3"
  }
}
